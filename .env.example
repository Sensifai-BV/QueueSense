# ── Injected by Coolify at deploy time ─────────────
# Keep every key here in sync with what the code reads.
# Non-secret values = production defaults. Secrets = filled by you / Coolify.

# ── SENSIFAI platform (PRODUCTION) ─────────────────
LOGTO_ENDPOINT=https://auth.sensifai.com
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
LOGTO_SCOPES="openid profile email"
PUBLIC_URL=https://queuesense.sensifai.com
SENSIFAI_GATEKEEPER_URL=https://gatekeeper.sensifai.com
SENSIFAI_API_KEY=smp_live_...
SENSIFAI_WEBHOOK_SECRET=whsec_...

# Pay-as-you-go price model UUID (default for all apps) — created at submission
SENSIFAI_PRICE_ID=

# ── LiteLLM gateway — the ONLY way to call AI ──
AI_GATEWAY_URL=https://llm.sensifai.com
AI_GATEWAY_KEY=sk-...
